---
import ArticleCard from "../../components/ArticleCard.astro";
import Layout from "../../layouts/EditorialLayout.astro";
import { getCollection } from "astro:content";
import { isPublishable } from "../../lib/publishing.js";
import { topics } from "../../data/topics.js";

export async function getStaticPaths() {
  const published = (await getCollection("articles"))
    .filter(isPublishable);

  return topics.map(topic => ({
    params: { slug: topic.slug },
    props: {
      topic,
      related: published.filter(
        article => article.data.category === topic.slug
      )
    }
  }));
}

const { topic, related } = Astro.props;
---
<Layout title={topic.title} description={topic.description}>
  <div class="eyebrow">{topic.eyebrow}</div>
  <h1>{topic.title}</h1>
  <p class="lead">{topic.description}</p>

  <h2>Explore articles</h2>
  {related.length === 0 ? (
    <div class="notice">
      New articles for this topic are in development.
    </div>
  ) : (
    <div class="topic-grid">
      {related.map(article => (
        <ArticleCard {article} heading="h3" />
      ))}
    </div>
  )}
  <a href="/topics/" class="back-link">← All topics</a>
</Layout>
