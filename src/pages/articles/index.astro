---
import { Image } from "astro:assets";
import Layout from "../../layouts/EditorialLayout.astro";
import { getCollection } from "astro:content";
import { isPublishable } from "../../lib/publishing.js";

const articles = (await getCollection("articles"))
  .filter(isPublishable);
---
<Layout title="Articles" description="Wellness articles from Vera Health Notes.">
  <div class="eyebrow">The journal</div>
  <h1>Wellness notes & research.</h1>
  <p class="lead">
    Thoughtful, evidence-informed articles for everyday wellness decisions.
  </p>

  {articles.length === 0 ? (
    <div class="notice">
      Our article library is currently in development.
    </div>
  ) : (
    <div class="topic-grid">
      {articles.map(article => (
        <a class="topic-link" href={`/articles/${article.data.slug}/`}>
          <span>{article.data.category.replaceAll("-", " ")}</span>
          {article.data.hero && <Image src={article.data.hero.image} alt="" width={480} class="article-card-image" />}
          <h2>{article.data.title}</h2>
          <p>{article.data.description || "Explore this article."}</p>
          <strong>Read article ↗</strong>
        </a>
      ))}
    </div>
  )}
</Layout>
