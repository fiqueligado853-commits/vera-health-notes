---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  format?: "A_LIST" | "B_SYMPTOMS" | "C_EVIDENCE" | "D_GUIDE";
}

const { headings, format } = Astro.props;
const sections = headings.filter(heading => heading.depth === 2);
const label = format ? {
  A_LIST: "Jump to an item",
  B_SYMPTOMS: "Explore this topic",
  C_EVIDENCE: "Jump to a question",
  D_GUIDE: "In this guide"
}[format] : "On this page";
---
{sections.length >= 4 && (
  <nav class="article-contents" aria-labelledby="article-contents-title">
    <p id="article-contents-title">{label}</p>
    <ul>
      {sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
    </ul>
  </nav>
)}

<style>
  .article-contents{display:block;background:#eef1e9;border:1px solid #d9e2d7;border-radius:12px;padding:22px 24px}
  p{font-weight:700;margin:0 0 8px}
  ul{list-style:none;margin:0;padding:0}
  a{display:block;padding:5px 0;font-size:.9375rem;line-height:1.45;color:#325247;text-decoration:underline;text-underline-offset:.18em}
  a:hover{color:#203a30}
  @media(max-width:980px){ul{columns:2;column-gap:1.5rem}li{break-inside:avoid}}
  @media(max-width:520px){ul{columns:1}a{min-height:36px}}
</style>
