---
const {
  title,
  description = "Independent perspectives on everyday wellness.",
  canonical = Astro.url.pathname,
} = Astro.props;

const site = "https://vera-health-notes.pages.dev";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(canonical, site).href} />
  <title>{title} | Vera Health Notes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="announcement">Independent perspectives for more informed wellness decisions.</div>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="brand">V<span>.</span> <small>VERA HEALTH NOTES</small></a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/topics/">Topics</a>
        <a href="/articles/">Articles</a>
        <a href="/about/">About</a>
      </nav>
    </div>
  </header>

  <main class="container content">
    <slot />
  </main>

  <footer>
    <div class="container">
      <strong>VERA HEALTH NOTES</strong>
      <p>Clearer perspectives on everyday wellness.</p>
      <nav aria-label="Footer navigation">
        <a href="/about/">About</a>
        <a href="/editorial-policy/">Editorial Policy</a>
        <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
      </nav>
      <p class="disclaimer">For informational purposes only. Not medical advice.</p>
      <p>© {new Date().getFullYear()} Vera Health Notes.</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#f8f7f3;color:#24352b;font-family:"DM Sans",Arial,sans-serif}
a{color:inherit;text-decoration:none}
.container{width:min(1100px,calc(100% - 40px));margin:auto}
.announcement{background:#203a30;color:white;text-align:center;padding:12px;font-size:12px;letter-spacing:.04em}
.header{border-bottom:1px solid #e0e2da}
.header-inner{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.brand{font:38px "DM Serif Display",Georgia,serif;white-space:nowrap}
.brand span{color:#a87f50}
.brand small{font:700 13px "DM Sans",sans-serif;letter-spacing:.13em;vertical-align:middle;margin-left:8px}
nav{display:flex;gap:22px;flex-wrap:wrap}
nav a{font-size:12px;font-weight:600}
nav a:hover,.topic-link:hover{color:#a87f50}
.content{min-height:60vh;padding:85px 0 110px}
.eyebrow{font-size:11px;letter-spacing:.2em;color:#a17b56;font-weight:700;text-transform:uppercase}
h1,h2,h3{font-family:"DM Serif Display",Georgia,serif;font-weight:400;line-height:1.12}
h1{font-size:clamp(45px,6vw,76px);margin:20px 0 28px;max-width:900px}
h2{font-size:34px;margin:42px 0 16px}
h3{font-size:24px}
.lead{font-size:18px;line-height:1.85;max-width:760px;color:#59695c}
.copy{font-size:15px;line-height:2;max-width:820px;color:#46594d}
.copy p{margin:0 0 22px}
.copy a{text-decoration:underline;text-underline-offset:3px}
.topic-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:50px}
.topic-link{display:block;padding:35px;border:1px solid #e1e3d9;background:#fdfcf9}
.topic-link span{color:#a17b56;font-size:11px;letter-spacing:.12em}
.topic-link h2{margin:30px 0 14px}
.topic-link p{line-height:1.8;color:#647366;font-size:14px}
.back-link{display:inline-block;margin-top:35px;border-bottom:1px solid #a17b56;font-size:13px;font-weight:700}
.notice{padding:25px;background:#eeeae1;border-left:3px solid #aa8865;margin:30px 0;max-width:780px;line-height:1.8}
footer{background:#172920;color:#e8ede6;padding:60px 0 35px}
footer strong{letter-spacing:.14em}
footer p{font-size:12px;color:#bfcbc1;line-height:1.7}
footer nav{margin:28px 0}
footer .disclaimer{font-size:11px}
@media(max-width:700px){
.header-inner{align-items:flex-start;flex-direction:column;padding:22px 0;gap:17px}
.header nav{gap:14px}
.topic-grid{grid-template-columns:1fr}
.content{padding:55px 0 75px}
h1{font-size:46px}
.brand{font-size:32px}
}
</style>
